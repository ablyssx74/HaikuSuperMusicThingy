# Maintainer: Kris Beazley <supermusicthingy@epluribusunix.net>
#
# Local development package: builds directly from the working tree you have
# checked out (whatever is on disk, staged or not), so `makepkg -si` from
# this directory always packages your current changes. There is
# intentionally no `source=()` download step.
#
# Usage:
#   cd linux/packaging
#   makepkg -si

pkgname=haikusupermusicthingy
_repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
pkgver=$(sed 's/^v//' "$_repo_root/VERSION" | tr -d '[:space:]')
pkgrel=1
pkgdesc="Free streaming media client for SomaFM (Qt6/libmpv Linux port)"
arch=('x86_64')
url="https://github.com/ablyssx74/HaikuSuperMusicThingy"
license=('MIT')
depends=('qt6-base' 'qt6-svg' 'mpv')
makedepends=('cmake' 'qt6-base' 'qt6-svg' 'pkgconf')
source=()
sha256sums=()

build() {
    cmake -B "$srcdir/build" -S "$_repo_root/linux" \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr
    cmake --build "$srcdir/build"
}

package() {
    DESTDIR="$pkgdir" cmake --install "$srcdir/build"
}
